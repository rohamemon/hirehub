# Copy to .env and fill in. NEVER commit the real .env file.
# Docker Compose reads this file; the backend also reads backend/.env when run locally.

# --- Database ---
POSTGRES_PASSWORD=change-me
# For local (non-Docker) backend runs; Compose builds its own URL from POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://hirehub:change-me@localhost:5433/hirehub

# --- Security ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ENVIRONMENT=development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- URLs ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Email: console (dev, logs only - nothing is sent) or smtp ---
EMAIL_BACKEND=console
EMAIL_FROM=HireHub <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Files (private storage directory) ---
UPLOAD_DIR=./storage
